<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GensokyoLauncher.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button.nav">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF" />
    </Style>
    <Style Selector="Button.toolbarIcon">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#A01B1B22" />
      <Setter Property="BorderBrush" Value="#20FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style Selector="Button.gameTile">
      <Setter Property="Width" Value="166" />
      <Setter Property="Height" Value="236" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.gameTile:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Border.tileSurface">
      <Setter Property="BoxShadow" Value="0 5 14 0 #70000000" />
    </Style>
    <Style Selector="Button.gameTile:pointerover Border.tileSurface">
      <Setter Property="BoxShadow" Value="0 8 22 0 #B0000000" />
    </Style>
    <Style Selector="Button.horizontalTile">
      <Setter Property="Width" Value="280" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Height" Value="168" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.horizontalTile:pointerover">
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
  </Application.Styles>
</Application>
